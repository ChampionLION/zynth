# ─── Zynth environment ───────────────────────────────────────────
# Copy to .env.local. Account storage and AI feedback are configured separately.

# "mock" (default) = deterministic practice quests and feedback.
# "live" = Gemini/Groq LLM chain. Accounts still require Supabase in both modes.
NEXT_PUBLIC_ZYNTH_MODE=mock

# Supabase — run schema.sql then migrations/20261015_auth_and_resume.sql on a new project.
# Allow your app's /auth/callback and /auth/reset-password URLs in Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback; never place a service-role key in either public field.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LLM providers (live mode, server-side only)
GEMINI_API_KEY=
GROQ_API_KEY=

# Trusted progression — server-only; see docs/expansion/STEP1_ROLLOUT.md.
# Keep off until the foundation/actions SQL, compatible app and credentials are ready.
ZYNTH_TRUSTED_COMPLETION=0
# Explicit grading mode: practice uses deterministic feedback; live uses providers above.
ZYNTH_MODEL_MODE=practice
# Add privately in the hosting environment. Never prefix this name with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
