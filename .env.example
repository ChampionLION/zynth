# ─── Zynth environment ───────────────────────────────────────────
# Copy to .env.local and fill in to switch from local mock mode to live.

# "mock" (default) = everything on-device, no keys needed.
# "live" = Supabase persistence + Gemini/Groq LLM chain.
NEXT_PUBLIC_ZYNTH_MODE=mock

# Supabase (live mode) — run supabase/schema.sql first
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LLM providers (live mode, server-side only)
GEMINI_API_KEY=
GROQ_API_KEY=
